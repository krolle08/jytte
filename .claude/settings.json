{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/branch_gate.sh\"",
            "timeout": 5,
            "statusMessage": "Branch gate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/bindmount_probe.sh\"",
            "timeout": 20,
            "statusMessage": "Bind-mount probe"
          }
        ]
      }
    ]
  }
}
