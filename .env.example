ANTHROPIC_API_KEY=
JYTTE_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional: ACLED conflict event data. Register at acleddata.com (free).
ACLED_KEY=
ACLED_EMAIL=

# Azure DevOps widget (F4 / FEAT-002). PAT minted at:
#   https://dev.azure.com/<org>/_usersSettings/tokens
# Required PAT scopes: Code: Read, Build: Read, Work Items: Read + Write
# (Write is used only for the System.State transition; the writer refuses
#  every other field.)
#
# Primary instance = Trustworks (live).
AZDO_ORG=
AZDO_PROJECT=
AZDO_PAT=
AZDO_USER_EMAIL=
# Quote the value if it contains a space (e.g. "App Team")
AZDO_TEAM=
# Enable flag for the primary instance. Absent = enabled.
AZDO_ENABLED=true

# --- Additional instance: Dagrofa (FEAT-002) ---
# Configured but SHIPPED DARK. While AZDO_ENABLED_DAGROFA is false, Jytte
# never issues a single request to this org - it shows as "awaiting
# activation" on the dashboard. Fill these in, then flip the flag to true
# and restart when you are ready to let Jytte read the Dagrofa org.
AZDO_ORG_DAGROFA=
AZDO_PROJECT_DAGROFA=
AZDO_PAT_DAGROFA=
AZDO_USER_EMAIL_DAGROFA=
AZDO_TEAM_DAGROFA=
AZDO_ENABLED_DAGROFA=false

# Emails widget (FEAT-001). Read-only IMAP. Use an app password, not your
# primary account password. If these are unset the card simply shows
# "not configured" - nothing else breaks.
EMAIL_IMAP_HOST=outlook.office365.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=nichlas.madsen@trustworks.dk
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_FETCH_LIMIT=30
# Comma-separated sender domains that route into each bucket. Everything
# else falls into Private.
EMAIL_DOMAINS_TRUSTWORKS=trustworks.dk
EMAIL_DOMAINS_DAGROFA=dagrofa.dk,dagrofa.com

# ComputerWorld widget (FEAT-004). Reads the SAME mailbox as the emails
# widget (EMAIL_IMAP_* above) and pulls article links out of the
# ComputerWorld newsletters. Only the sender match is widget-specific.
EMAIL_COMPUTERWORLD_SENDER=computerworld.dk
COMPUTERWORLD_SCAN_LIMIT=5
COMPUTERWORLD_MAX_ARTICLES=20

# Football news widget (FEAT-005). RSS aggregation ranked FCK -> Superliga
# -> UEFA -> FIFA -> world, transfers boosted. Leave FOOTBALLNEWS_FEEDS
# empty to use the built-in defaults (Guardian/BBC/ESPN + best-effort DK).
FOOTBALLNEWS_FEEDS=
FOOTBALLNEWS_TRANSFER_FOCUS=true
FOOTBALLNEWS_MAX_ITEMS=30

# F5 - n8n integration substrate.
# JYTTE_INTERNAL_SECRET gates POST /widgets/<name>/state and /error so
# only services inside our trust boundary (n8n in the same Docker
# network / k3s namespace) can push. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JYTTE_INTERNAL_SECRET=

# n8n's encryption key for credentials stored in its DB. Generate the
# same way; DO NOT rotate without re-entering every credential in the
# n8n UI - losing this key makes stored credentials unrecoverable.
N8N_ENCRYPTION_KEY=

# When true (only flip after the pilot has proven stable), Jytte's
# watchdog will attempt a one-shot restart of n8n after 3 consecutive
# failures. Requires docker.sock mount in dev or k3s API access in prod.
JYTTE_AUTO_RESTART_N8N=false
