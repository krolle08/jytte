ANTHROPIC_API_KEY=
JYTTE_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional: ACLED conflict event data. Register at acleddata.com (free).
ACLED_KEY=
ACLED_EMAIL=

# Azure DevOps widget (F4). PAT minted at:
#   https://dev.azure.com/<org>/_usersSettings/tokens
# Required PAT scopes: Code: Read, Build: Read, Work Items: Read
AZDO_ORG=
AZDO_PROJECT=
AZDO_PAT=
AZDO_USER_EMAIL=
# Quote the value if it contains a space (e.g. "App Team")
AZDO_TEAM=

# F5 - n8n integration substrate.
# JYTTE_INTERNAL_SECRET gates POST /widgets/<name>/state and /error so
# only services inside our trust boundary (n8n in the same Docker
# network / k3s namespace) can push. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JYTTE_INTERNAL_SECRET=

# n8n's encryption key for credentials stored in its DB. Generate the
# same way; DO NOT rotate without re-entering every credential in the
# n8n UI - losing this key makes stored credentials unrecoverable.
N8N_ENCRYPTION_KEY=

# When true (only flip after the pilot has proven stable), Jytte's
# watchdog will attempt a one-shot restart of n8n after 3 consecutive
# failures. Requires docker.sock mount in dev or k3s API access in prod.
JYTTE_AUTO_RESTART_N8N=false

# Where n8n is reachable FROM YOUR BROWSER, not from inside the Docker
# network. It is only ever used to build links (the "Åbn" buttons on
# /jobs and /workflows point at <this>/workflow/<id>), so it has to be
# the address you would type yourself. Defaults to http://localhost:5678.
# Change it when n8n moves to the home server.
N8N_BASE_URL=

# ----------------------------------------------------------------------
# Mail widget (`email`), fetched by deploy/n8n/workflows/email.json.
#
# Auth is NOT configured here. The workflow reads Microsoft Graph with
# an n8n "Microsoft Outlook OAuth2" credential (delegated Mail.Read +
# offline_access), which lives encrypted in n8n's own credential store.
# Nothing below is a secret - these are only shaping knobs.
#
# Create the Entra app registration yourself; see deploy/n8n/README.md
# for the exact redirect URL and scope list.
# ----------------------------------------------------------------------

# How many messages to pull per run, and how far back to look.
EMAIL_FETCH_LIMIT=30
EMAIL_LOOKBACK_HOURS=72

# Sender-domain buckets. Comma-separated; a subdomain of a listed
# domain matches it too (nyhedsbrev.computerworld.dk -> computerworld).
# Anything unmatched is tagged `other`.
EMAIL_DOMAINS_TRUSTWORKS=trustworks.dk
EMAIL_DOMAINS_DAGROFA=dagrofa.dk,dagrofa.com
EMAIL_COMPUTERWORLD_SENDER=computerworld.dk

# IMAP settings are LEGACY and unused by the Graph workflow. n8n's IMAP
# node is trigger-only (it cannot sit behind a Schedule Trigger) and
# M365 is retiring IMAP basic auth. Left documented so the vars already
# present in some .env files are not mistaken for live config.
#EMAIL_IMAP_HOST=outlook.office365.com
#EMAIL_IMAP_PORT=993
#EMAIL_IMAP_MAILBOX=INBOX
#EMAIL_IMAP_USER=
#EMAIL_IMAP_PASSWORD=

# ----------------------------------------------------------------------
# Calendar widget (`calendar`), fetched by deploy/n8n/workflows/calendar.json.
#
# Same Entra app registration as the mail flow, one extra delegated
# scope: Calendars.Read. Nothing below is a secret.
# ----------------------------------------------------------------------
CALENDAR_WINDOW_DAYS=1
CALENDAR_FETCH_LIMIT=50

# ----------------------------------------------------------------------
# Bank widget (`bank`), fetched by deploy/n8n/workflows/bank.json over
# open banking (PSD2 AIS).
#
# Auth is NOT configured here. The aggregator's secret_id/secret_key
# pair lives in an n8n "Custom Auth" credential, encrypted in n8n's own
# store. Jytte holds no bank credential.
#
# Create the account and complete the bank consent yourself; see
# app/widgets/bank/CLAUDE.md and deploy/n8n/README.md for the curl
# sequence. Never let an agent mint the key or approve the consent.
# ----------------------------------------------------------------------

# The consent you completed in the browser. An identifier, not a
# credential: it authenticates nothing without the secret pair, which
# is why it may live here and the pair may not.
BANK_REQUISITION_ID=

# How far back the transaction list reaches. The default end-user
# agreement grants 90 days of history and 90 days of access.
BANK_LOOKBACK_DAYS=30

# ----------------------------------------------------------------------
# Stocks widget (`stocks`) - Nordnet portfolio.
#
# No key and no n8n flow: Nordnet has no API a private customer can
# reach (all three paths probed 2026-10-14, see
# app/widgets/stocks/CLAUDE.md). The portfolio is a CSV you export and
# drop in a folder; the newest *.csv wins.
#
# The path below is the CONTAINER path, already set in
# docker-compose.yml and bound to ./data/nordnet on the host. Listed
# here only so the variable is discoverable.
# ----------------------------------------------------------------------
#JYTTE_NORDNET_DIR=/data/nordnet

# Cloudflare tunnel for the bank consent redirect. You create the
# tunnel yourself (deploy/cloudflared/config.yml has the steps); this
# is the id that `cloudflared tunnel create` prints.
CLOUDFLARE_TUNNEL_ID=

# n8n webhook that exchanges the bank authorization code for a session.
# n8n holds the signing key; Jytte only forwards. Leave blank and the
# callback page shows the code so it can be used by hand.
JYTTE_BANK_SESSION_WEBHOOK=
